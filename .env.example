# ── Despliegue ────────────────────────────────────────────────────────────────
IMAGE_NAME=nvf/payments-ms
IMAGE_VERSION=latest
CONTAINER_NAME=payments-ms
HOST_PORT=8083
BIND_ADDRESS=0.0.0.0
RESTART_POLICY=unless-stopped
DOCKER_NETWORK=local_network

# ── App ───────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_GOENV=local
SERVER_CONTEXT_PATH=/payments-ms-01

# ── MySQL ─────────────────────────────────────────────────────────────────────
DATABASE_MYSQL_HOST=localhost
DATABASE_MYSQL_PORT=3306
DATABASE_MYSQL_USER=root
DATABASE_MYSQL_PASSWORD=123456
DATABASE_MYSQL_NAME=payments_ms_01

# ── Redis ─────────────────────────────────────────────────────────────────────
DATA_REDIS_HOST=localhost
DATA_REDIS_PORT=6379
DATA_REDIS_PASSWORD=

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_me_in_prod

# ── MercadoPago ───────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=change_me
MERCADOPAGO_WEBHOOK_SECRET=change_me
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_NOTIFICATION_URL=https://your-domain.com/payments-ms-01/api/payments/webhook
MERCADOPAGO_BACK_URL=https://your-domain.com/app/es/home

# ── Seguridad ─────────────────────────────────────────────────────────────────
INTERNAL_SECRET=change_me_in_prod

# ── Queue names (override per environment to avoid cross-env message theft) ──
# prod: leave empty (defaults used)
# stage: set _stage suffix on all queues
MARKETPLACE_AD_APPROVED_QUEUE=
AD_PAYMENT_MANUAL_QUEUE=
